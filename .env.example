# Für lokale Entwicklung: kopiere diese Datei nach .env und passe die Werte an.
# Für Docker Compose: kopiere diese Datei nach .env im selben Ordner wie docker-compose.yml.

DATABASE_URL="file:./prisma/dev.db"

# 32-byte (64 Hex-Zeichen) Schlüssel zur AES-256-GCM-Verschlüsselung der SSH-Credentials.
# Erzeugen mit: openssl rand -hex 32
MASTER_SECRET=""

# Secret zum Signieren der Login-Session-JWTs. Erzeugen mit: openssl rand -hex 32
AUTH_SECRET=""

# Nur für den Seed-Skript verwendet, um den ersten Admin-Account anzulegen.
SEED_ADMIN_EMAIL="admin@netmaster.local"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Admin"

PORT=3000

# Nur für Docker Compose: Host-Port, auf dem der Container erreichbar ist.
HOST_PORT=3000

# Setze auf "true", wenn NetMaster hinter TLS (https://) erreichbar ist,
# z.B. hinter einem Reverse-Proxy. Bei "true" wird das Session-Cookie mit dem
# Secure-Flag gesetzt, das Browser über reines HTTP verwerfen - daher steht
# der Default auf "false" (passend zu direktem HTTP-Zugriff per IP:Port).
COOKIE_SECURE=false

# VAPID-Schlüsselpaar für Web-Push-Benachrichtigungen (Konto -> Push
# aktivieren). Wird beim ersten Start automatisch generiert und in der
# Datenbank gespeichert - hier NUR setzen, wenn du feste Keys erzwingen
# willst (z.B. bei mehreren Instanzen mit geteilter Datenbank).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- NAS-Gateway (zentrales Web/FTP/SFTP/Samba für NAS-User) ---
# Setze COMPOSE_PROFILES=nas (oder "nas,proxy" zusammen mit Caddy), um den
# netmaster-nas-gateway-Service mitzustarten.

# Secret zur gegenseitigen Authentifizierung zwischen Hauptcontainer und
# NAS-Gateway (beide Richtungen). Erzeugen mit: openssl rand -hex 32
NAS_INTERNAL_SECRET=""

# Vom Hauptcontainer aus erreichbare Basis-URL des Gateways (Passwort-Sync-
# Push) - unter network_mode: host ist das localhost mit dem Files-API-Port.
NAS_GATEWAY_INTERNAL_URL="http://localhost:4501"

# Vom Gateway aus erreichbare Basis-URL der Haupt-App (interne NAS-APIs).
NAS_MAIN_API_URL="http://localhost:3000"

# Ports, auf denen der NAS-Gateway FTP/FTPS/SFTP/die interne Datei-API anbietet.
NAS_FTP_ENABLED=true
NAS_FTP_PORT=21
NAS_FTPS_ENABLED=false
NAS_FTPS_PORT=990
# Bei FTPS zusätzlich Pfade zu Zertifikat/Key setzen:
NAS_FTP_TLS_CERT_PATH=""
NAS_FTP_TLS_KEY_PATH=""
# Öffentliche Host-Adresse für FTP Passive-Mode (nötig, wenn der Gateway
# hinter NAT erreichbar sein soll), z.B. die öffentliche IP/Domain des Hosts.
NAS_FTP_PASV_URL=""
NAS_SFTP_PORT=2222
NAS_FILES_API_PORT=4501
