# Für lokale Entwicklung: kopiere diese Datei nach .env und passe die Werte an.
# Für Docker Compose: kopiere diese Datei nach .env im selben Ordner wie docker-compose.yml.

DATABASE_URL="file:./prisma/dev.db"

# 32-byte (64 Hex-Zeichen) Schlüssel zur AES-256-GCM-Verschlüsselung der SSH-Credentials.
# Erzeugen mit: openssl rand -hex 32
MASTER_SECRET=""

# Secret zum Signieren der Login-Session-JWTs. Erzeugen mit: openssl rand -hex 32
AUTH_SECRET=""

# Nur für den Seed-Skript verwendet, um den ersten Admin-Account anzulegen.
SEED_ADMIN_EMAIL="admin@netmaster.local"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Admin"

PORT=3000

# Nur für Docker Compose: Host-Port, auf dem der Container erreichbar ist.
HOST_PORT=3000

# Setze auf "true", wenn NetMaster hinter TLS (https://) erreichbar ist,
# z.B. hinter einem Reverse-Proxy. Bei "true" wird das Session-Cookie mit dem
# Secure-Flag gesetzt, das Browser über reines HTTP verwerfen - daher steht
# der Default auf "false" (passend zu direktem HTTP-Zugriff per IP:Port).
COOKIE_SECURE=false

# VAPID-Schlüsselpaar für Web-Push-Benachrichtigungen (Konto -> Push
# aktivieren). Wird beim ersten Start automatisch generiert und in der
# Datenbank gespeichert - hier NUR setzen, wenn du feste Keys erzwingen
# willst (z.B. bei mehreren Instanzen mit geteilter Datenbank).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
