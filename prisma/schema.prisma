// NetMaster – Netzwerkadministratorpanel
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum AuthType {
  PASSWORD
  PRIVATE_KEY
}

enum Status {
  UNKNOWN
  OK
  WARNING
  CRITICAL
}

enum CheckType {
  HTTP
  PING
}

enum VmType {
  QEMU
  LXC
}

enum RouterDeviceType {
  FRITZBOX
  REPEATER
}

enum JobKind {
  PREDEFINED
  SSH_COMMAND
}

enum JobScheduleType {
  INTERVAL
  CRON
}

enum PredefinedAction {
  RECONCILE_NOW
  CLEANUP_LOGS
  DB_BACKUP
  RUN_SERVICE_CHECKS
}

enum JobRunStatus {
  SUCCESS
  FAILED
  PARTIAL
  SKIPPED
}

enum JobRunTrigger {
  SCHEDULE
  MANUAL
}

enum NasMountTransport {
  SSHFS
  NFS
}

enum NasShareRole {
  READ_ONLY
  READ_WRITE
}

enum NasAuditAction {
  LOGIN
  LOGIN_FAILED
  QUOTA_EXCEEDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())

  // UI-Sprache des Accounts ("en" | "de" | "nl" | "fr" | "es"), folgt dem
  // Login geräteübergreifend. Wird zusätzlich im NEXT_LOCALE-Cookie
  // gespiegelt (siehe src/lib/locale.ts), damit die Sprache schon vor dem
  // ersten Server-Roundtrip (Login-Seite) verfügbar ist.
  locale       String   @default("en")

  // Erzwingt nach dem nächsten Login eine Passwortänderung, bevor die App
  // sonst nutzbar ist – wird von "netmaster reset-login" gesetzt.
  mustChangePassword Boolean @default(false)

  // TOTP-Secret liegt auch während des Setups (vor Verifikation) hier,
  // totpEnabled wird erst nach erfolgreicher Code-Verifikation gesetzt.
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  totpFailedAttempts Int       @default(0)
  totpLockedUntil    DateTime?

  dashboardLayout    DashboardLayout?
  sessions           Session[]
  webauthnCredentials WebAuthnCredential[]
  backupCodes        BackupCode[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences NotificationPreference[]
  serviceCheckSubscriptions ServiceCheckSubscriber[]
}

// Automatisch beim ersten Start generiertes VAPID-Schlüsselpaar für
// Web-Push (siehe src/lib/push.ts). Es gibt zur Laufzeit höchstens eine
// Zeile - wird beim Serverstart erzeugt, falls noch keine existiert, damit
// kein manueller Setup-Schritt nötig ist.
// Singleton (id ist immer "singleton") - verhindert per Unique-Constraint,
// dass bei gleichzeitigem Erststart mehrerer Prozesse zwei Schlüsselpaare
// entstehen und Geräte dadurch mit unterschiedlichen Keys signiert werden.
model VapidKeys {
  id         String   @id @default("singleton")
  publicKey  String
  privateKey String
  subject    String
  createdAt  DateTime @default(now())
}

// Ein Web-Push-Endpunkt (i.d.R. ein installiertes/geöffnetes Browser- bzw.
// PWA-Fenster). Ein User kann mehrere haben (mehrere Geräte/Browser).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

// Pro User+Server einstellbar, welche Ereignisse eine Push-Benachrichtigung
// auslösen. Fehlt ein Eintrag für ein User/Server-Paar, gelten die Defaults
// unten (Offline/Kritisch an, Warnung/Docker-gestoppt aus).
model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId             String
  server               Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  offlineEnabled       Boolean  @default(false)
  offlineDelayMin      Int      @default(0)
  offlineRecoveryEnabled Boolean @default(false)
  dockerStoppedEnabled Boolean  @default(false)
  dockerStoppedDelayMin Int     @default(0)
  dockerStoppedRecoveryEnabled Boolean @default(false)

  // Pro Metrik getrennte Warn-/Kritisch-Toggles, statt eines generischen
  // Warning/Critical-Schalters für den gesamten Server-Status. Verzögerung
  // (Min bis Alarm) und Recovery-Toggle ("wieder normal") sind je Ereignis
  // separat konfigurierbar - siehe src/lib/monitor/alert-delay.ts für die
  // Auswertung.
  cpuWarnEnabled  Boolean @default(false)
  cpuWarnDelayMin Int     @default(0)
  cpuWarnRecoveryEnabled Boolean @default(false)
  cpuCritEnabled  Boolean @default(false)
  cpuCritDelayMin Int     @default(0)
  cpuCritRecoveryEnabled Boolean @default(false)
  memWarnEnabled  Boolean @default(false)
  memWarnDelayMin Int     @default(0)
  memWarnRecoveryEnabled Boolean @default(false)
  memCritEnabled  Boolean @default(false)
  memCritDelayMin Int     @default(0)
  memCritRecoveryEnabled Boolean @default(false)
  diskWarnEnabled Boolean @default(false)
  diskWarnDelayMin Int    @default(0)
  diskWarnRecoveryEnabled Boolean @default(false)
  diskCritEnabled Boolean @default(false)
  diskCritDelayMin Int    @default(0)
  diskCritRecoveryEnabled Boolean @default(false)
  netWarnEnabled  Boolean @default(false)
  netWarnDelayMin Int     @default(0)
  netWarnRecoveryEnabled Boolean @default(false)
  netCritEnabled  Boolean @default(false)
  netCritDelayMin Int     @default(0)
  netCritRecoveryEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@unique([userId, serverId])
}

// Passkeys (WebAuthn, discoverable credentials). Sobald ein User hier
// mindestens einen Eintrag hat, ist Passwort-Login (und damit auch TOTP)
// für diesen Account gesperrt – siehe src/lib/auth.ts.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String    @default("")
  name         String    @default("Passkey")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// Einmal-Codes für TOTP-Wiederherstellung (falls das Authenticator-Gerät
// verloren geht, das Passwort aber noch bekannt ist). Werden gehasht
// gespeichert, beim Verbrauch mit usedAt markiert statt gelöscht.
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Datenbankgestützte Login-Sessions. Das Cookie enthält nur ein signiertes
// JWT mit der Session-ID (siehe session-token.ts) – die eigentliche
// Gültigkeitsprüfung (Widerruf einzelner Sessions) läuft gegen diese Tabelle.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model Server {
  id          String   @id @default(cuid())
  name        String
  hostname    String
  sshPort     Int      @default(22)
  sshUsername String
  authType    AuthType @default(PASSWORD)

  // AES-256-GCM verschlüsselt (iv:authTag:ciphertext, base64)
  encryptedSecret String
  // Optionale Passphrase für PRIVATE_KEY, ebenfalls AES-256-GCM verschlüsselt
  encryptedPassphrase String?
  // Optionales Sudo-Passwort für privilegierte Befehle (z.B. reboot/shutdown
  // als Nicht-root-User), ebenfalls AES-256-GCM verschlüsselt
  encryptedSudoPassword String?

  pollIntervalSec Int @default(30)
  // Nicht mehr von scheduler.ts gelesen (siehe PollingSettings.advancedPollingEnabled/
  // advancedPollingIntervalSec, das seit dem Advanced-Polling-Umbau global steuert,
  // ob/wie schnell Proxmox/Docker im Hintergrund gepollt werden). Feld bleibt aus
  // Migrations-Kompatibilität erhalten, ist aber vestigial - Kandidat für eine
  // spätere Entfernung.
  vmDockerPollIntervalSec Int @default(7200)
  retentionDays   Int @default(30)

  // Docker/Proxmox werden nur abgefragt, wenn hier explizit aktiviert.
  dockerEnabled  Boolean @default(true)
  proxmoxEnabled Boolean @default(true)
  // Schaltet Firewall-Verwaltung, Port-Übersicht und Netzwerk-Graph frei.
  networkToolsEnabled Boolean @default(false)
  // Schaltet WireGuard-Verwaltung (Interfaces/Peers) frei.
  wireguardEnabled Boolean @default(false)
  // Schaltet die Storage-Verwaltung frei (Disks/Partitionen/LVM/RAID,
  // NFS-Server/-Client, Samba-Freigaben inkl. User-Verwaltung).
  storageEnabled Boolean @default(false)

  cpuWarn  Float @default(70)
  cpuCrit  Float @default(90)
  memWarn  Float @default(75)
  memCrit  Float @default(90)
  diskWarn Float @default(80)
  diskCrit Float @default(95)

  // Durchsatz-Schwellwerte in Mbit/s, getrennt für Up-/Download (Verbindungen
  // sind meist asymmetrisch). 0 deaktiviert die jeweilige Prüfung nicht -
  // ein sehr hoher Wert (z.B. 0) würde sofort auslösen, daher Defaults für
  // ein typisches 1-Gbit-Netz.
  netUploadWarn    Float @default(800)
  netUploadCrit    Float @default(950)
  netDownloadWarn  Float @default(800)
  netDownloadCrit  Float @default(950)

  description String @default("")
  tags        String @default("") // comma-separated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastStatus    Status   @default(UNKNOWN)
  lastError     String?
  lastCheckedAt DateTime?

  // Letzter bekannter Status je Einzelmetrik, um Push-Benachrichtigungen pro
  // Metrik flankengetriggert (nur bei Statuswechsel) auslösen zu können -
  // lastStatus allein reicht dafür nicht, da er nur den schlechtesten Wert
  // aller Metriken abbildet.
  lastCpuStatus  Status @default(UNKNOWN)
  lastMemStatus  Status @default(UNKNOWN)
  lastDiskStatus Status @default(UNKNOWN)
  lastNetStatus  Status @default(UNKNOWN)

  // Zeitpunkt, seit dem der jeweilige Zustand ununterbrochen besteht - Basis
  // für die verzögerte ("erst nach X Minuten") Alarmierung und dafür, ob bei
  // Erholung eine Recovery-Nachricht fällig ist (siehe alert-delay.ts). Wird
  // beim Eintritt in den Zustand gesetzt, beim Verlassen wieder auf null
  // gesetzt.
  offlineSince   DateTime?
  cpuWarnSince   DateTime?
  cpuCritSince   DateTime?
  memWarnSince   DateTime?
  memCritSince   DateTime?
  diskWarnSince  DateTime?
  diskCritSince  DateTime?
  netWarnSince   DateTime?
  netCritSince   DateTime?

  // Statische Host-Eigenschaften, bei jedem erfolgreichen Poll aktualisiert
  // (ändern sich quasi nie, daher kein eigener Zeitverlauf).
  cpuCores      Int?
  memTotalMb    Float?
  osName        String?
  kernelVersion String?
  bootedAt      DateTime?

  metricSamples MetricSample[]
  diskSamples   DiskSample[]
  serviceChecks ServiceCheck[]
  snippets      Snippet[]
  containerSnapshots DockerContainerSnapshot[]
  imageSnapshots     DockerImageSnapshot[]
  proxmoxVms    ProxmoxVm[]
  auditLogs     AuditLog[]
  notificationPreferences NotificationPreference[]
  dockerContainerStates DockerContainerState[]
  pollLogs      PollLog[]
  nasShares     NasShare[]
}

// Persistierter Laufzustand je Docker-Container (unabhängig von den nur 24h
// gehaltenen DockerContainerSnapshot-Zeilen), um die Dauer eines Stopps für
// die verzögerte Benachrichtigung sowie Recovery-Nachrichten zu verfolgen.
model DockerContainerState {
  id          String    @id @default(cuid())
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  containerId String
  name        String
  running     Boolean   @default(true)
  stoppedSince DateTime?
  // Siehe ProxmoxVm.ipsJson - dasselbe Muster für Docker-Container (ermittelt per
  // 'docker inspect', refreshDockerIp in collect.ts).
  ipsJson     String    @default("[]")
  updatedAt   DateTime  @updatedAt

  @@unique([serverId, containerId])
  @@index([serverId])
}

model MetricSample {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())

  cpuPercent  Float?
  memPercent  Float?
  diskPercent Float?
  loadAvg1    Float?
  loadAvg5    Float?
  loadAvg15   Float?
  netRxBytes  Float?
  netTxBytes  Float?

  @@index([serverId, timestamp])
}

// Protokolliert jede tatsächliche Poll-Ausführung (unabhängig vom Ergebnis
// als MetricSample/Snapshot) - dient ausschließlich der Debug-Ansicht
// (admin/debug/[serverId]), die Poll-Zeitpunkte als vertikale Marker über dem
// CPU/RAM/Disk-Graph anzeigt. Feste 2-Tage-Aufbewahrung statt
// server.retentionDays, siehe Pruning in collect.ts.
model PollLog {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  pollType  String
  timestamp DateTime @default(now())
  success   Boolean

  @@index([serverId, timestamp])
}

model DiskSample {
  id         String   @id @default(cuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  timestamp  DateTime @default(now())

  mountpoint String
  device     String
  totalKb    Float?
  usedKb     Float?
  percent    Float?

  @@index([serverId, mountpoint, timestamp])
}

// serverId ist optional: ein Check kann an einen Server gebunden sein (dann
// zusätzlich in dessen Detailansicht sichtbar) oder frei/global stehen (z.B.
// eine eigene Domain ohne zugehörigen Server in NetMaster).
model ServiceCheck {
  id             String    @id @default(cuid())
  serverId       String?
  server         Server?   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name           String
  url            String
  checkType      CheckType @default(HTTP)
  expectedStatus Int       @default(200)
  intervalSec    Int       @default(30)
  timeoutMs      Int       @default(5000)

  // Latenz-Schwelle (ms) für die WARNING-Stufe bei PING/HTTP - null
  // deaktiviert die Latenz-Überwachung für diesen Check.
  latencyWarnMs Int?

  lastStatus    Status    @default(UNKNOWN)
  lastLatencyMs Float?
  lastCheckedAt DateTime?
  lastError     String?

  // Siehe Server.cpuCritSince etc. - Basis für verzögerte Down-/Slow-Alarme.
  downSince DateTime?
  slowSince DateTime?

  createdAt DateTime @default(now())

  results     ServiceCheckResult[]
  subscribers ServiceCheckSubscriber[]
}

// Wiederverwendbare Shell-Befehlsfolgen, die aus den Server-Details heraus
// live im Terminal ausgeführt werden können. serverId=null macht ein Snippet
// auf jedem Server nutzbar (global), sonst nur auf dem angegebenen Server.
model Snippet {
  id           String   @id @default(cuid())
  serverId     String?
  server       Server?  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name         String
  // JSON-Array einzelner Befehlszeilen, nacheinander ausgeführt.
  commandsJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Wer bei einem Ausfall eines Checks per Push benachrichtigt wird - nur für
// freistehende (serverId=null) Checks relevant, serverbezogene Checks nutzen
// weiterhin keine eigene Benachrichtigung.
model ServiceCheckSubscriber {
  id             String       @id @default(cuid())
  serviceCheckId String
  serviceCheck   ServiceCheck @relation(fields: [serviceCheckId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  downEnabled         Boolean @default(false)
  downDelayMin        Int     @default(0)
  downRecoveryEnabled Boolean @default(false)
  slowEnabled         Boolean @default(false)
  slowDelayMin        Int     @default(0)
  slowRecoveryEnabled Boolean @default(false)

  createdAt      DateTime     @default(now())

  @@unique([serviceCheckId, userId])
}

model ServiceCheckResult {
  id             String       @id @default(cuid())
  serviceCheckId String
  serviceCheck   ServiceCheck @relation(fields: [serviceCheckId], references: [id], onDelete: Cascade)
  timestamp      DateTime     @default(now())
  success        Boolean
  statusCode     Int?
  latencyMs      Float?

  @@index([serviceCheckId, timestamp])
}

model DockerContainerSnapshot {
  id          String   @id @default(cuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
  containerId String
  name        String
  image       String
  state       String
  cpuPercent  Float?
  memUsageMb  Float?
  netRxMb     Float?
  netTxMb     Float?

  @@index([serverId, timestamp])
}

// Momentaufnahme der auf einem Server vorhandenen Docker-Images (via
// 'docker images'). Analog zu DockerContainerSnapshot wird nur die jeweils
// letzte Momentaufnahme pro Server behalten.
model DockerImageSnapshot {
  id           String   @id @default(cuid())
  serverId     String
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  timestamp    DateTime @default(now())
  imageId      String
  repository   String
  tag          String
  sizeMb       Float?
  createdLabel String @default("")

  @@index([serverId, timestamp])
}

// Ein Proxmox-Host wird per SSH auf 'pvesh get /cluster/resources' abgefragt;
// jede gefundene VM/LXC bekommt genau eine Zeile, die bei jedem Poll
// aktualisiert wird (aktueller Zustand).
model ProxmoxVm {
  id       String @id @default(cuid())
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  vmid   Int
  type   VmType
  name   String
  status String // running, stopped, paused, ...

  cpuPercent  Float?
  memUsedMb   Float?
  memTotalMb  Float?
  diskUsedGb  Float?
  diskTotalGb Float?

  // Zuletzt bekannte IP(s) als JSON-Array, ermittelt per Guest-Agent (QEMU) bzw.
  // 'ip addr show' (LXC) - siehe refreshVmIp in collect.ts. Persistiert (statt nur
  // im In-Memory-Cache), damit Ping und Anzeige auch über einen Neustart hinweg
  // sofort verfügbar sind; wird von der leichtgewichtigen IP-Discovery (siehe
  // ip-discovery-scheduler.ts) alle 5 Min aktualisiert.
  ipsJson String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  samples ProxmoxVmSample[]

  @@unique([serverId, vmid])
}

model ProxmoxVmSample {
  id        String    @id @default(cuid())
  vmId      String
  vm        ProxmoxVm @relation(fields: [vmId], references: [id], onDelete: Cascade)
  timestamp DateTime  @default(now())

  cpuPercent  Float?
  memPercent  Float?
  diskPercent Float?

  @@index([vmId, timestamp])
}

// Audit-Log für sicherheitskritische Aktionen (Terminal-Zugriff, Prozess-Kill).
// Es werden nur Metadaten protokolliert, keine Ein-/Ausgabe der Sessions.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  serverId  String?
  server    Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
  @@index([userId, createdAt])
}

model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layoutJson String  @default("[]")
  updatedAt DateTime @updatedAt
}

// Ein per Netzwerk-Scan (Explore, nmap) gefundenes Gerät. Bei jedem Scan
// aktualisiert (Upsert) - für Hosts mit MAC-Adresse (LAN, per ARP ermittelt)
// per mac, für Hosts ohne (z.B. VPN-Peers über ein reines Layer-3-Tunnel-
// Interface wie WireGuard, wo ARP nicht existiert) per ip, siehe scan.ts.
// Geräte, die bei einem Scan nicht mehr gefunden werden, bleiben erhalten
// (lastSeenOnline=false) statt gelöscht zu werden, damit die Historie
// sichtbar bleibt.
model DiscoveredHost {
  id       String  @id @default(cuid())
  ip       String
  mac      String? @unique
  hostname String?
  vendor   String?

  // JSON-Array offener Ports ({port, service, version}[])
  openPortsJson String  @default("[]")
  osGuess       String?

  lastSeenOnline Boolean @default(true)

  // Range, in der der Host beim letzten Scan gefunden wurde. Wird bei jedem
  // Scan neu gesetzt; verweist die Range nicht mehr, bleibt der Host mit
  // rangeId=null erhalten (siehe ExploreRange).
  rangeId String?
  range   ExploreRange? @relation(fields: [rangeId], references: [id], onDelete: SetNull)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([ip])
  @@index([rangeId])
}

enum ExploreRangeSource {
  LAN_AUTO
  VPN_AUTO
  MANUAL
}

// Eine zu scannende CIDR-Range für Explore. LAN_AUTO/VPN_AUTO-Zeilen werden
// vom Scheduler (reconcileRanges, alle 15s) aus den lokalen Netzwerk-
// Interfaces des Hosts erzeugt/entfernt, je nachdem ob das zugehörige
// Interface noch existiert; enabled bleibt dabei ein reiner User-Override,
// der vom Reconcile nicht zurückgesetzt wird. MANUAL-Zeilen legt der Nutzer
// selbst an und verwaltet sie frei (bearbeiten/löschen).
model ExploreRange {
  id     String             @id @default(cuid())
  cidr   String
  source ExploreRangeSource

  // Name des Interfaces, aus dem die Range erkannt wurde (z.B. "wg0",
  // "eth0"). Nur bei LAN_AUTO/VPN_AUTO gesetzt.
  interfaceName String?

  enabled Boolean @default(true)

  hosts DiscoveredHost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, interfaceName])
}

// Konfiguration für die Explore-Netzwerkscans. Singleton-Tabelle (analog zu
// VapidKeys) - es existiert höchstens eine Zeile, bei Bedarf beim ersten
// Zugriff angelegt.
model ExploreSettings {
  id String @id @default(cuid())

  autoScanEnabled    Boolean @default(false)
  autoScanIntervalHr Int     @default(24)

  // Wie viele Port-Scans (nmap -sV pro Host) maximal gleichzeitig laufen.
  portScanConcurrency Int @default(5)

  updatedAt DateTime @updatedAt
}

// Globale Debug-Schalter, um jede Polling-Art für die gesamte Instanz einzeln
// abzuschalten (z.B. um einen Zielserver während einer Störungssuche zu
// entlasten). Singleton-Tabelle (analog zu VapidKeys/ExploreSettings).
// Wirkt additiv zu bestehenden Pro-Server-Flags (Server.dockerEnabled etc.)
// und zu ExploreSettings.autoScanEnabled - beide müssen aktiv sein, damit der
// jeweilige Job läuft. Server-seitige Felder werden vom Scheduler-Reconcile
// (alle 15s) ausgewertet, Client-seitige Felder werden per WS-Broadcast
// ("polling-settings"-Event) live an offene Browser-Tabs verteilt.
model PollingSettings {
  id String @id @default(cuid())

  // Server-seitige Hintergrund-Jobs (src/lib/monitor/scheduler.ts)
  serverMetricsEnabled     Boolean @default(true)
  dockerContainersEnabled  Boolean @default(true)
  dockerImagesEnabled      Boolean @default(true)
  proxmoxVmsEnabled        Boolean @default(true)
  routerDevicesEnabled     Boolean @default(true)
  uptimeChecksEnabled      Boolean @default(true)
  discoveryScanEnabled     Boolean @default(true)

  // Client-seitige Live-Ansichten (setInterval im Browser)
  topologyGraphEnabled     Boolean @default(true)
  portsEnabled             Boolean @default(true)
  dashboardLookupsEnabled  Boolean @default(true)
  wsProcessesEnabled       Boolean @default(true)

  // Zentrale Ping-Erreichbarkeitsprüfung (src/lib/monitor/ping-scheduler.ts) -
  // läuft vom Netmaster-Server aus gegen bekannte VM-/Container-IPs, ersetzt
  // den bisherigen häufigen Proxmox-/Docker-Status-Poll als Live-Signal.
  pingEnabled     Boolean @default(true)
  pingIntervalSec Int     @default(15)

  // Globaler "Vollgas"-Schalter: schaltet Live-Polling für ALLE Proxmox-/Docker-
  // Server ein (unabhängig von Server.vmDockerPollIntervalSec, das dafür nicht
  // mehr gelesen wird - siehe scheduler.ts). Nur für Admins über die Navbar
  // umschaltbar; wird automatisch wieder deaktiviert, sobald kein Client mehr per
  // WebSocket verbunden ist (siehe server.ts).
  advancedPollingEnabled     Boolean @default(false)
  advancedPollingIntervalSec Int     @default(30)

  updatedAt DateTime @updatedAt
}

// FritzBox / FritzRepeater, abgefragt per TR-064 (SOAP über HTTP-Digest-Auth,
// Standardport 49000, TLS-Variante 49443). Eigenständige Geräte, keine
// Mesh-Hierarchie zwischen FritzBox und Repeater.
model RouterDevice {
  id       String           @id @default(cuid())
  name     String
  type     RouterDeviceType
  hostname String
  port     Int              @default(49000)
  useTls   Boolean          @default(false)
  username String

  // AES-256-GCM verschlüsselt (iv:authTag:ciphertext, base64), wie bei Server.
  encryptedPassword String

  pollIntervalSec Int @default(60)

  lastStatus    Status    @default(UNKNOWN)
  lastError     String?
  lastCheckedAt DateTime?

  // Statische Geräteinfos (DeviceInfo:1#GetInfo)
  modelName       String?
  firmwareVersion String?
  uptimeSec       Int?

  // WAN-Status (nur FritzBox relevant, bei Repeater leer)
  wanConnectionStatus String?
  wanExternalIp       String?

  // JSON-Array verbundener Hosts ({name, ip, mac, active, interfaceType}[]),
  // via TR-064 Hosts:1-Service ermittelt.
  connectedHostsJson String @default("[]")

  // JSON-Array der WLAN-Funknetze ({index, ssid, enabled, band}[])
  wifiNetworksJson String @default("[]")

  samples RouterSample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Durchsatz-Samples für den Verlaufsgraph in der Router-Übersicht. Speichert
// kumulative Byte-Zähler (wie MetricSample.netRxBytes/netTxBytes) statt
// fertiger Raten - die Rate wird aus zwei Messpunkten client-/serverseitig
// berechnet. Feste 7-Tage-Aufbewahrung statt eines konfigurierbaren Felds
// (bei nur wenigen Router-Geräten kein nennenswerter Speicherbedarf).
// Ein NetMaster-eigener geplanter Job - entweder eine fest eingebaute Aktion
// (PredefinedAction) oder ein freier Shell-Befehl, der per SSH auf einem oder
// mehreren Servern ausgeführt wird (targetServerIdsJson). Der Zeitplan ist
// entweder ein einfaches Intervall oder ein Cron-Ausdruck - siehe
// src/lib/jobs/scheduler.ts für die Auswertung.
model Job {
  id      String  @id @default(cuid())
  name    String
  enabled Boolean @default(true)

  kind              JobKind
  predefinedAction  PredefinedAction?
  // Nur für kind=SSH_COMMAND: der auszuführende Shell-Befehl sowie die
  // Ziel-Server (JSON-Array von Server-IDs).
  command             String?
  targetServerIdsJson String  @default("[]")

  scheduleType   JobScheduleType
  intervalSec    Int?
  cronExpression String?

  timeoutSec Int @default(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastRunAt     DateTime?
  lastRunStatus JobRunStatus?

  runs JobRun[]
}

// Protokoll einer einzelnen Job-Ausführung. resultsJson enthält bei
// SSH_COMMAND-Jobs ein Ergebnis je Ziel-Server
// ({serverId, serverName, success, exitCode, output}[]), bei PREDEFINED-Jobs
// ein einzelnes Ergebnis.
model JobRun {
  id      String @id @default(cuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status      JobRunStatus
  trigger     JobRunTrigger
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
  resultsJson String        @default("[]")
  error       String?

  @@index([jobId, startedAt])
}

model RouterSample {
  id             String       @id @default(cuid())
  routerDeviceId String
  routerDevice   RouterDevice @relation(fields: [routerDeviceId], references: [id], onDelete: Cascade)
  timestamp      DateTime     @default(now())

  bytesReceived Float?
  bytesSent     Float?

  // Aktive Hosts im Zeitpunkt der Messung - bei Repeatern (kein WAN-Durchsatz
  // verfügbar) die einzige sinnvolle Zeitreihe für den Verlauf-Chart.
  connectedDevices Int?

  @@index([routerDeviceId, timestamp])
}

// ---------------------------------------------------------------------------
// NAS: eigene, von den Webmaster-Usern komplett getrennte Identität für
// Zugriff auf Datei-Freigaben (Web/FTP/SFTP/Samba, zentral über den
// NAS-Gateway-Container). Siehe Plan "Zentrales NAS-System mit eigenen
// NAS-Usern" für die Architektur (Mount-Manager, interne APIs etc.).
// ---------------------------------------------------------------------------

model NasUser {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  locale       String  @default("en")

  mustChangePassword Boolean @default(false)
  // Vom Admin steuerbar, ob dieser NAS-User öffentliche Freigabe-Links
  // erzeugen darf (siehe NasShareLink).
  canCreatePublicLinks Boolean @default(true)

  // Zusätzlich zu einer eventuellen Quota auf einzelnen NasShares: eine
  // Gesamt-Quota über alle Freigaben, bei denen dieser User das einzige
  // Mitglied ist ("private" Freigaben). Geteilte Freigaben mit mehreren
  // Mitgliedern zählen NICHT hinein, da usedBytes dort nicht pro Mitglied
  // aufgeschlüsselt werden kann (kein Datei-Eigentümer-Tracking, siehe
  // samba.ts "force user = root"). Wird wie bei NasShare.quotaBytes app-
  // seitig geprüft (siehe /api/internal/nas/usage).
  quotaBytes BigInt?

  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  totpFailedAttempts Int       @default(0)
  totpLockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    NasSession[]
  memberships NasShareMember[]
  shareLinks  NasShareLink[]
}

// Datenbankgestützte Login-Sessions für NAS-User, analog zu Session/User,
// aber komplett getrennt (eigenes Cookie, siehe nas-session-token.ts) - eine
// NAS-Session darf niemals als Webmaster-Session interpretiert werden.
model NasSession {
  id         String    @id @default(cuid())
  nasUserId  String
  nasUser    NasUser   @relation(fields: [nasUserId], references: [id], onDelete: Cascade)
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([nasUserId])
}

// Eine Freigabe liegt auf einem bestehenden, storageEnabled-Server (Admin
// wählt Server+Pfad). Der NAS-Gateway mountet remotePath von diesem Server
// per SSHFS/NFS und exportiert es zentral. Quota wird app-seitig periodisch
// geprüft (kein Kernel-Quota, da der Speicherort per FUSE-Mount eingebunden
// ist) - siehe quota.ts im Gateway.
model NasShare {
  id       String @id @default(cuid())
  name     String
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  remotePath      String
  mountTransport  NasMountTransport @default(SSHFS)

  quotaBytes BigInt?
  usedBytes  BigInt  @default(0)
  lastUsageCheckAt DateTime?
  // Wird vom Gateway gesetzt, sobald usedBytes > quotaBytes - blockt weitere
  // Schreibzugriffe über alle Protokolle, bis der Admin Platz schafft/Quota
  // erhöht (kein automatisches Zurücksetzen, um Datenverlust durch knappes
  // Pendeln um die Grenze zu vermeiden).
  readOnlyLocked Boolean @default(false)

  // Zuletzt vom Gateway gemeldeter Mount-Status (siehe
  // /api/internal/nas/mount-status), rein informativ fürs Admin-UI.
  mountActive Boolean   @default(false)
  mountError  String?
  mountedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members NasShareMember[]
  links   NasShareLink[]
}

model NasShareMember {
  shareId   String
  share     NasShare     @relation(fields: [shareId], references: [id], onDelete: Cascade)
  nasUserId String
  nasUser   NasUser      @relation(fields: [nasUserId], references: [id], onDelete: Cascade)
  role      NasShareRole @default(READ_WRITE)

  createdAt DateTime @default(now())

  @@unique([shareId, nasUserId])
  @@index([nasUserId])
}

// Öffentlicher, unauthentifizierter Zugriffslink auf einen Pfad innerhalb
// einer Freigabe (siehe /nas-link/[token]). Erstellung ist pro NAS-User über
// canCreatePublicLinks steuerbar.
model NasShareLink {
  id                 String    @id @default(cuid())
  shareId            String
  share              NasShare  @relation(fields: [shareId], references: [id], onDelete: Cascade)
  path               String
  token              String    @unique
  createdByNasUserId String
  createdByNasUser   NasUser   @relation(fields: [createdByNasUserId], references: [id], onDelete: Cascade)
  passwordHash       String?
  expiresAt          DateTime?

  createdAt DateTime @default(now())

  @@index([shareId])
}

// Nur Basis-Events (kein granulares Datei-Operations-Log). nasUserId ist
// optional, da ein fehlgeschlagener Login-Versuch keinen validen User hat -
// die E-Mail wird trotzdem als Snapshot gespeichert.
model NasAuditLog {
  id          String          @id @default(cuid())
  nasUserId   String?
  nasUserEmail String
  action      NasAuditAction
  detail      String          @default("")
  createdAt   DateTime        @default(now())

  @@index([nasUserId, createdAt])
}

// Singleton (analog zu ExploreSettings/VapidKeys), hält die von außen
// erreichbare Adresse + Ports des NAS-Gateways, um daraus den kopierbaren
// Verbindungstext (Samba/FTP/FTPS/SFTP/Web) zu bauen. Die Ports laufen als
// eigene Env-Variablen im Gateway-Container (network_mode: host) und sind
// der Haupt-App sonst nicht bekannt - der Admin trägt sie hier passend zu
// seiner .env einmalig ein.
model NasGatewaySettings {
  id String @id @default(cuid())

  publicHost String @default("")

  ftpEnabled  Boolean @default(true)
  ftpPort     Int     @default(21)
  ftpsEnabled Boolean @default(false)
  ftpsPort    Int     @default(990)
  sftpPort    Int     @default(2222)

  updatedAt DateTime @updatedAt
}
